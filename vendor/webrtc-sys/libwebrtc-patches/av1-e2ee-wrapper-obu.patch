+inline bool FrameIsAv1(webrtc::TransformableFrameInterface* frame,
+                       webrtc::FrameCryptorTransformer::MediaType type) {
+  switch (type) {
+    case webrtc::FrameCryptorTransformer::MediaType::kVideoFrame: {
+      auto videoFrame =
+          static_cast<webrtc::TransformableVideoFrameInterface*>(frame);
+      return videoFrame->header().codec ==
+             webrtc::VideoCodecType::kVideoCodecAV1;
+    }
+    default:
+      return false;
+  }
+}
+
+// PATCH (Tin Hat) AV1 E2EE: the AV1 RTP packetizer parses and rewrites OBU
+// headers (drops temporal delimiters, strips obu_size fields), and the
+// depacketizer rewrites every OBU header with obu_has_size_field=1 plus a
+// fresh LEB128 size. Encrypted bytes therefore never round-trip, and a
+// fixed-count header carve-out cannot work. Instead, encryptFrame() encrypts
+// the ENTIRE original frame and wraps the ciphertext in ONE synthetic
+// OBU_FRAME header with obu_has_size_field=0 (OBU payloads are opaque to the
+// packetizer, and "no size field" means rest-of-payload), and decryptFrame()
+// parses and discards that wrapper. The plaintext handed to the decoder is
+// byte-identical to the encoder output. The wrapper is NOT part of the
+// ciphertext or the AAD; frame_header stays empty for AV1 on both sides.
+//
+// Keyframes additionally lead with an EMPTY synthetic sequence-header OBU:
+// the packetizer only sets the N ("new coded video sequence") aggregation bit
+// when the frame's FIRST OBU is a sequence header (rtp_packetizer_av1.cc),
+// and the depacketizer derives kVideoFrameKey purely from that bit. Without
+// it the receiver never sees a keyframe: frame assembly stalls forever behind
+// a PLI storm (measured: 20 PLIs, 0 frames). The RTP layer never parses
+// sequence-header CONTENT, so empty is safe, and decrypt discards it anyway.
+constexpr uint8_t kAv1WrapperObuHeader = 0x30;  // OBU_FRAME, no ext, no size
+constexpr uint8_t kAv1WrapperSeqHdrObu[2] = {0x0a, 0x00};  // OBU_SEQUENCE_HEADER, size=0
+// Grep-able vintage stamp (strings <binary> | grep tinhat-av1-e2ee): proves which
+// cryptor build a binary actually links — a stale cargo shadow archive once
+// made v1 masquerade as v2 through four diagnostic cycles.
+constexpr char kTinHatAv1E2eeStamp[] = "tinhat-av1-e2ee-v2";
+
+// Returns the byte offset where the ciphertext starts (after the synthetic
+// OBU prefix), or 0 if the prefix cannot be parsed. Handles both the sent
+// form ([0x0a 0x00] 0x30 ...) and the depacketizer-normalized received form
+// ([0x0a 0x00] 0x32 leb128 ...).
+inline size_t Av1WrapperCiphertextOffset(
+    webrtc::ArrayView<const uint8_t> data) {
+  size_t off = 0;
+  for (int obu_count = 0; obu_count < 4; ++obu_count) {
+    if (off + 1 >= data.size())
+      return 0;
+    const uint8_t header = data[off];
+    if (header & 0x80)
+      return 0;  // obu_forbidden_bit must be 0
+    const int obu_type = (header >> 3) & 0xF;
+    size_t pos = off + 1;
+    if (header & 0x04)  // obu_extension_flag
+      pos += 1;
+    uint64_t size = 0;
+    const bool has_size = (header & 0x02) != 0;
+    if (has_size) {  // LEB128 size field
+      size_t leb = 0;
+      while (true) {
+        if (pos >= data.size() || leb >= 8)
+          return 0;
+        const uint8_t b = data[pos++];
+        size |= static_cast<uint64_t>(b & 0x7F) << (7 * leb);
+        leb++;
+        if (!(b & 0x80))
+          break;
+      }
+    }
+    if (obu_type == 6) {
+      // The FRAME wrapper: ciphertext is everything after its prefix. Its
+      // size field (absent as sent; added by the depacketizer) is advisory —
+      // the IV/trailer are located from the buffer END regardless.
+      return pos < data.size() ? pos : 0;
+    }
+    if (obu_type == 1) {
+      // Synthetic keyframe sequence header: skip header + payload.
+      if (!has_size || pos + size >= data.size())
+        return 0;
+      off = pos + static_cast<size_t>(size);
+      continue;
+    }
+    return 0;  // not something we ever emit
+  }
+  return 0;
+}
