+/*
+ * PATCH (Tin Hat) — tinhat_iv.h: the sender's AES-GCM IV allocator (stamp tinhat-iv-v2) and the VP9 keyframe IV
+ * step (stamp tinhat-vp9-kf-iv-v1). Header-only and std-only on purpose: the desktop repo's
+ * vendor/webrtc-sys/libwebrtc-patches/tests/tinhat_iv_test.cc compiles THIS file against real AES-GCM.
+ *
+ * IV = domain (4 bytes) || counter (8 bytes), 12 bytes, EVERY BYTE NONZERO and byte 0 >= 4 (stamp tinhat-iv-v2; see
+ * "H.264-safe layout" below). One allocator per process (ProcessIvAllocator,
+ * frame_crypto_transformer.cc): every sealing cryptor of the process (mic, camera, share, every SSRC, simulcast
+ * layer, SVC layer, every call room, every key) takes its IVs from it. Next() hands out each counter value once,
+ * the counter never wraps (exhausted at 255^8: Next() refuses, the frame is dropped). A Tin Hat call key is
+ * minted per join / rotation in one process and never leaves it, so within that key's lifetime no (key, IV) pair
+ * can repeat. The receiver reads the IV from the frame trailer, so the layout is a sender-side choice:
+ * wire-compatible with every receiver. Argument in full: the desktop repo's
+ * vendor/webrtc-sys/libwebrtc-patches/README.md ("IV uniqueness").
+ *
+ * H.264-safe layout (12.1.8, tinhat-iv-v2). For H.264/H.265 the sender RBSP-escapes ciphertext || IV || trailer
+ * (H264::WriteRbsp: a 0x03 before any byte <= 3 that follows two 0x00), while every receiver in users' hands reads
+ * the IV from the RAW tail of the frame before unescaping. v1's big-endian counter (top bytes 00 00 00) put an escape
+ * inside the IV of every H.264 frame. v2 writes no zero byte at all: the domain bytes are mapped into 1..255 (byte 0
+ * into 4..255) and the counter is written as 8 base-255 digits, each + 1 (a bijection on c < 255^8, so uniqueness is
+ * unchanged). Then no escape can land inside IV || trailer: one before IV[k >= 1] needs two zero bytes in front of it
+ * (inside the IV, or the tag's last byte + IV[0]), and IV bytes are never 0; before T0 (= ivLength 12 > 3) none; before
+ * T1 (the key index) it needs (IV[11], T0) = 00 00. The only junction escape possible, tag ... 00 00 | IV[0], needs
+ * IV[0] <= 3, and byte 0 is >= 4; were it ever to happen, it would sit BEFORE IV[0], i.e. outside the 14-byte tail the
+ * receiver reads, so even then the read would be right.
+ */
+#ifndef API_CRYPTO_TINHAT_IV_H_
+#define API_CRYPTO_TINHAT_IV_H_
+
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+
+namespace tinhat {
+
+constexpr char kTinHatIvStamp[] = "tinhat-iv-v2";
+constexpr char kTinHatVp9KfIvStamp[] = "tinhat-vp9-kf-iv-v1";
+constexpr int kVp9KfIvMaxTries = 512;
+
+using Iv = std::array<uint8_t, 12>;
+
+class IvAllocator {
+ public:
+  // 255^8: the number of 8-digit base-255 counter values (> 2^63).
+  static constexpr uint64_t kCounterLimit = 17878103347812890625ull;
+
+  IvAllocator(uint32_t domain, uint64_t start) : next_(start) {
+    // the domain's random bytes, mapped so that none is 0 and byte 0 is >= 4 (H.264-safe layout, above)
+    domain_[0] = static_cast<uint8_t>(4 + ((domain >> 24) & 0xff) % 252);
+    for (int i = 1; i < 4; i++) domain_[i] = static_cast<uint8_t>(1 + ((domain >> (24 - 8 * i)) & 0xff) % 255);
+  }
+  IvAllocator(const IvAllocator&) = delete;
+  IvAllocator& operator=(const IvAllocator&) = delete;
+
+  // The counter as 8 base-255 digits, most significant first, each + 1 (every byte 1..255). c < kCounterLimit.
+  static void EncodeCounter(uint64_t c, uint8_t* out8) {
+    for (int i = 7; i >= 0; i--) {
+      out8[i] = static_cast<uint8_t>(c % 255 + 1);
+      c /= 255;
+    }
+  }
+
+  // The next unused IV, or nullopt once the counter is exhausted (never reused, never wrapped).
+  std::optional<Iv> Next() {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (next_ >= kCounterLimit) return std::nullopt;
+    const uint64_t c = next_++;
+    Iv iv;
+    for (int i = 0; i < 4; i++) iv[i] = domain_[i];
+    EncodeCounter(c, iv.data() + 4);
+    return iv;
+  }
+
+ private:
+  std::mutex mu_;
+  std::array<uint8_t, 4> domain_{};
+  uint64_t next_;
+};
+
+// Byte-for-byte the LiveKit SFU's test on byte 0 of a VP9 payload (mediatransportutil codec.IsVP9KeyFrame, after
+// the RTP descriptor's B bit). Shared vectors: the desktop repo's testvectors/vp9-kf-iv/vectors.json.
+inline bool Vp9ByteLooksLikeKeyFrame(uint8_t b) {
+  if ((b & 0xc0) != 0x80) return false;
+  const uint8_t profile = (b >> 4) & 0x3;
+  if (profile != 3) return (b & 0x0c) == 0;
+  return (b & 0x06) == 0;
+}
+
+enum class Vp9IvStep { kMatched, kCapMiss, kSealFailed, kExhausted };
+
+struct Vp9IvResult {
+  Vp9IvStep step = Vp9IvStep::kCapMiss;
+  int tries = 0;
+  Iv iv{};
+};
+
+// The VP9 keyframe IV step: take candidates from `alloc` until ciphertext byte 0 under that IV gives the SFU the
+// right verdict (keyframe <=> looks like one). seal_first_byte(iv, &c0) seals ONE byte (the frame's first plaintext
+// byte) under the candidate IV and returns ciphertext byte 0; it is a private computation (its output and tag are
+// discarded). Every candidate is consumed from the allocator (never handed out again). Only kMatched may be sent:
+// the caller drops the frame on kCapMiss / kSealFailed / kExhausted.
+template <typename SealFirstByte>
+Vp9IvResult StepVp9Iv(IvAllocator& alloc, bool want_key, SealFirstByte seal_first_byte,
+                      int max_tries = kVp9KfIvMaxTries) {
+  Vp9IvResult r;
+  for (int t = 1; t <= max_tries; t++) {
+    std::optional<Iv> iv = alloc.Next();
+    r.tries = t;
+    if (!iv) {
+      r.step = Vp9IvStep::kExhausted;
+      return r;
+    }
+    r.iv = *iv;
+    uint8_t c0 = 0;
+    if (!seal_first_byte(r.iv, &c0)) {
+      r.step = Vp9IvStep::kSealFailed;
+      return r;
+    }
+    if (Vp9ByteLooksLikeKeyFrame(c0) == want_key) {
+      r.step = Vp9IvStep::kMatched;
+      return r;
+    }
+  }
+  r.step = Vp9IvStep::kCapMiss;
+  return r;
+}
+
+// The process's one allocator (frame_crypto_transformer.cc).
+IvAllocator& ProcessIvAllocator();
+
+}  // namespace tinhat
