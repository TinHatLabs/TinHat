+inline bool SplitRxTail(const uint8_t* body, size_t n, uint8_t want_iv_len, size_t min_ct_len, RxTail* out) {
+  if (body == nullptr || n < 2) return false;
+  const uint8_t iv_len = body[n - 2];
+  if (iv_len != want_iv_len) return false;
+  if (n < static_cast<size_t>(iv_len) + 2 + min_ct_len) return false;
+  out->iv_len = iv_len;
+  out->key_index = body[n - 1];
+  out->iv_off = n - 2 - iv_len;
+  out->ct_len = out->iv_off;
+  return true;
+}
