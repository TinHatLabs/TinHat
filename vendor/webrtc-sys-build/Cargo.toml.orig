[package]
name = "webrtc-sys-build"
version = "0.3.18"
edition.workspace = true
license.workspace = true
description = "Build utilities when working with libwebrtc"
repository.workspace = true

[dependencies]
reqwest = { version = "0.12", default-features = false, features = ["rustls-tls-native-roots", "blocking"] }
# PATCH (Tin Hat, 2026-10-31): zip 9.0.5, decompression only (see Cargo.toml)
zip = { version = "9.0.5", default-features = false, features = ["deflate-flate2"] }
flate2 = { version = "1.1", default-features = false, features = ["rust_backend"] }
regex = "1.0"
scratch = "1.0"
fs2 = "0.4"
semver = "1.0"
anyhow = { workspace = true }
