{
  "about": "Media Party: Undo after Clear (QOL A16.2, product call P11 (a)). input.queue = the queue NOW (others may have added since the Clear), input.cleared = the queue as it was when I pressed Clear; expect = the urls after Undo: the cleared items in their order, then anything added since that isn't one of them. Replayed by the desktop (watchparty.rs queue_undo_clear) and Tin Hat Web (queue.ts undoClear).",
  "cases": [
    {
      "name": "the queue is still empty: the cleared list comes back",
      "input": {
        "queue": [],
        "cleared": [
          {
            "addedBy": "@a:example.com",
            "title": "T1",
            "url": "https://www.youtube.com/watch?v=v0000000001"
          },
          {
            "addedBy": "@a:example.com",
            "title": "T2",
            "url": "https://www.youtube.com/watch?v=v0000000002"
          },
          {
            "addedBy": "@a:example.com",
            "title": "T3",
            "url": "https://www.youtube.com/watch?v=v0000000003"
          }
        ]
      },
      "expect": [
        "https://www.youtube.com/watch?v=v0000000001",
        "https://www.youtube.com/watch?v=v0000000002",
        "https://www.youtube.com/watch?v=v0000000003"
      ]
    },
