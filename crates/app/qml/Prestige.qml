pragma Singleton
// Prestige.qml — the prestige ranks every name label reads (mini games v1, GAMES-V1-SPEC rev 2 §3), with no plumbing:
// AppCore sets `ctl` (the PrestigeController) and mirrors its viewJson into `view`. The web's features/prestige/store.ts.
//   lookOf(mxid, contextId)      {r: rank, g: pack glyph, c: "muted"|"text"|"accent", s: shine} or null (no token)
//   prestigeOf(mxid, contextId)  the rank (0 = no token)
//   want(mxid, contextId)        the name is on screen (the engine batches, caches 10 min, never draws a rank older
//                                than 1 h)
// contextId = the room the surface is about (its game space's rank) or a space's own id on its own surfaces (that
// space's rank); "" = no token (the account card, Settings, search, DMs and rooms in no space).
import QtQuick

QtObject {
    property var ctl: null
    // the pack's four prestige glyphs (prestige-symbolic / -filled / -ring / -star), tinted below before decode
    // BEGIN generated by games-token glyph.py: the pack's 24 px prestige glyphs, byte for byte (do not edit)
    readonly property var glyphs: ({
        "prestige-symbolic": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><defs><style id=\"current-color-scheme\" type=\"text/css\">.ColorScheme-Text { color:#eff0f1; }</style></defs><path class=\"ColorScheme-Text\" style=\"fill:currentColor\" fill-rule=\"evenodd\" d=\"M0.413 13.408 L2.499 12.365 L6.16 13.498 L11.58 1.151 L18.604 3.705 L15.917 6.661 L18.297 13.246 L21.545 12.135 L23.555 13.391 L21.754 19.35 L2.252 19.35 Z M3.948 17.05 L20.046 17.05 L20.845 14.409 L21.255 14.665 L16.903 16.154 L13.283 6.139 L14.596 4.695 L12.82 4.049 L7.44 16.302 L2.701 14.835 L3.187 14.592 Z\"/></svg>\n",
        "prestige-filled-symbolic": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><defs><style id=\"current-color-scheme\" type=\"text/css\">.ColorScheme-Text { color:#eff0f1; }</style></defs><path class=\"ColorScheme-Text\" style=\"fill:currentColor\" fill-rule=\"evenodd\" d=\"M1.8 14 L2.6 13.6 L6.8 14.9 L12.2 2.6 L16.6 4.2 L14.6 6.4 L17.6 14.7 L21.4 13.4 L22.2 13.9 L20.9 18.2 L3.1 18.2 Z M13.405 7.761 L10.705 13.361 L11.695 13.839 L14.395 8.239 Z\"/></svg>\n",
        "prestige-ring-symbolic": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><defs><style id=\"current-color-scheme\" type=\"text/css\">.ColorScheme-Text { color:#eff0f1; }</style></defs><path class=\"ColorScheme-Text\" style=\"fill:currentColor\" fill-rule=\"evenodd\" d=\"M4.86 13.92 L5.42 13.64 L8.36 14.55 L12.14 5.94 L15.22 7.06 L13.82 8.6 L15.92 14.41 L18.58 13.5 L19.14 13.85 L18.23 16.86 L5.77 16.86 Z M12.983 9.553 L11.093 13.473 L11.787 13.807 L13.677 9.887 Z M23.65 12 A11.65 11.65 0 0 1 0.35 12 L1.85 12 A10.15 10.15 0 0 0 22.15 12 Z M0.35 12 A11.65 11.65 0 0 1 23.65 12 L22.15 12 A10.15 10.15 0 0 0 1.85 12 Z\"/></svg>\n",
        "prestige-star-symbolic": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><defs><style id=\"current-color-scheme\" type=\"text/css\">.ColorScheme-Text { color:#eff0f1; }</style></defs><path class=\"ColorScheme-Text\" style=\"fill:currentColor\" fill-rule=\"evenodd\" d=\"M4.86 13.92 L5.42 13.64 L8.36 14.55 L12.14 5.94 L15.22 7.06 L13.82 8.6 L15.92 14.41 L18.58 13.5 L19.14 13.85 L18.23 16.86 L5.77 16.86 Z M12.983 9.553 L11.093 13.473 L11.787 13.807 L13.677 9.887 Z M23.015 8.207 A11.65 11.65 0 1 1 15.793 0.985 L15.305 2.403 A10.15 10.15 0 1 0 21.597 8.695 Z M19.707 0.793 L20.56 3.119 L23.036 3.211 L21.086 4.741 L21.765 7.124 L19.707 5.743 L17.65 7.124 L18.328 4.741 L16.379 3.211 L18.855 3.119 Z\"/></svg>\n"
    })
    // END generated by games-token glyph.py
    // names asked before AppCore attached the controller (asked again the moment it is there)
    property var pending: []
    onCtlChanged: {
        if (!ctl) return
        var p = pending
        pending = []
        for (var i = 0; i < p.length; i++) ctl.want(p[i][0], p[i][1])
    }
    property var view: ({ ctx: ({}), scopes: ({}) })
    // people whose one-time shine has played in this run (§3.1: never looping)
    property var shone: ({})

    // "owner|space" of a surface context, "" = no token / not resolved yet
    function scopeOf(contextId) {
        var v = view
        if (!contextId || !v || !v.ctx) return ""
        var s = v.ctx[contextId]
        return s === undefined || s === null ? "" : String(s)
    }
    function lookOf(mxid, contextId) {
        if (!mxid) return null
        var sc = scopeOf(contextId)
        var m = (sc && view && view.scopes) ? view.scopes[sc] : null
        var l = m ? m[mxid] : null
        return (l && typeof l.r === "number" && l.r > 0) ? l : null
    }
    function prestigeOf(mxid, contextId) {
        var l = lookOf(mxid, contextId)
        return l ? l.r : 0
    }
    function want(mxid, contextId) {
        if (!mxid || !contextId) return   // no context: no token (rev 2 §3.3)
        if (ctl) ctl.want(String(mxid), String(contextId))
        else pending.push([String(mxid), String(contextId)])
    }
    // the label that asked is gone (refcounted with want): its name stops being refreshed / retried
    function forget(mxid, contextId) {
        if (!mxid || !contextId) return
        if (ctl) { ctl.forget(String(mxid), String(contextId)); return }
        for (var i = 0; i < pending.length; i++) {
            if (pending[i][0] === String(mxid) && pending[i][1] === String(contextId)) { pending.splice(i, 1); return }
        }
    }
    // A glyph tinted with `ink` (its rgb; the caller applies ink.a as opacity), as a data URL: the pack's own technique
    // (motion/ThIcon.qml tinted()), which works with the software scene graph and on Windows, where Kirigami.Icon's
    // recolour of a theme icon doesn't.
    function tinted(name, ink) {
        var svg = glyphs[name]
        if (!svg) return ""
        var ch = function (n) { var h = Math.round(n * 255).toString(16); return h.length < 2 ? "0" + h : h }
        return "data:image/svg+xml," + encodeURIComponent(svg.replace("#eff0f1", "#" + ch(ink.r) + ch(ink.g) + ch(ink.b)))
    }
    // "Prestige 4" (the tooltip and the accessible name; = the web's prestigeLabel)
    function label(rank) {
        return rank > 0 ? "Prestige " + rank : ""
    }
    // true the first time for a person in this run (the shine plays once)
    function claimShine(mxid) {
        if (!mxid || shone[mxid]) return false
        var s = shone
        s[mxid] = true
        shone = s
        return true
    }
}
