      "mxid": "@u:h.test",
      "sessions": [],
      "want": false
    },
    {
      "name": "an identity that reads like a bare port mxid is the port-less user's device 8448",
      "id": "@u:h.test:8448",
      "mxid": "@u:h.test",
      "sessions": [],
      "want": true
    },
    {
      "name": "... and not the port user (an identity is never compared as a bare mxid)",
      "id": "@u:h.test:8448",
      "mxid": "@u:h.test:8448",
      "sessions": [],
      "want": false
    },
    {
      "name": "':' device: not the look-alike",
      "id": "@a:h.test:8448:EVIL",
      "mxid": "@a:h.test:8448",
      "sessions": [
        [
          "@a:h.test",
          "8448:EVIL"
        ]
      ],
      "want": false
    },
    {
      "name": "':' device: its real owner",
      "id": "@a:h.test:8448:EVIL",
      "mxid": "@a:h.test",
      "sessions": [
        [
          "@a:h.test",
          "8448:EVIL"
        ]
      ],
      "want": true
    },
    {
      "name": "an empty mxid is nobody",
      "id": "x",
      "mxid": "",
      "sessions": [],
      "want": false
    }
  ],
  "participantOf": [
    {
