        "recent": 0,
        "web": 0
      },
      "expect": "none"
    },
    {
      "name": "Enter outside the search is left to the focused button",
      "key": "Enter",
      "mods": false,
      "inSearch": false,
      "query": "",
      "counts": {
        "fav": 3,
        "room": 0,
        "recent": 0,
        "web": 0
      },
      "expect": "type"
    },
    {
      "name": "letters type",
      "key": "a",
