        "fav": 2,
        "room": 1,
        "recent": 1,
        "web": 4
      },
      "expect": "fav:0"
    },
    {
      "name": "Enter with no favourite match plays the first room sound",
      "key": "Enter",
      "mods": false,
      "inSearch": true,
