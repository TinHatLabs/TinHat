{
 "v": 1,
 "about": "Tin Hat app badge (REACH A5.10): the taskbar / dock / home-screen unread count. Byte-identical copies: desktop crates/app/src/testvectors/app-badge.json (the owner) and web src/features/nav/testvectors/app-badge.json. Rule: the rooms (in input order) that are not spaces and either are joined with a settings-adjusted unread (A5.3: 0 when muted, the highlight count when mentions-only, else the notification count) above 0, or are a pending DM invite. The badge is the number of those rooms. Row fields: id; membership join|invite|leave; space; dm; mode all|mentions|mute; notif = the server's notification_count; highlight = its highlight_count. An invite's counts are ignored (its row shows 0). want = the ids the badge counts. global = the corner/global badge text (REACH A5.3 + A5.1): the sum of the joined non-space rows' adjusted unread plus 1 per pending DM invite (not a space), \"\" at 0, \"99+\" above 99.",
 "cases": [
  {
   "name": "empty",
   "rows": [],
   "want": [],
   "global": ""
  },
  {
   "name": "a53_rows",
   "note": "the A5.3 rollup_adjusted rows: a muted room and a space never count; one room is one, whatever its number",
   "rows": [
    {
     "id": "!muted",
     "membership": "join",
     "space": false,
     "dm": false,
     "mode": "mute",
     "notif": 5,
     "highlight": 0
    },
    {
     "id": "!mentions",
     "membership": "join",
     "space": false,
     "dm": false,
     "mode": "mentions",
     "notif": 10,
     "highlight": 1
    },
    {
     "id": "!dm",
     "membership": "join",
     "space": false,
     "dm": true,
     "mode": "all",
     "notif": 3,
     "highlight": 0
    },
    {
     "id": "!space",
     "membership": "join",
     "space": true,
     "dm": false,
     "mode": "all",
     "notif": 1,
     "highlight": 0
    }
   ],
   "want": [
    "!mentions",
    "!dm"
   ],
   "global": "4"
  },
  {
   "name": "mentions_only_without_highlight",
