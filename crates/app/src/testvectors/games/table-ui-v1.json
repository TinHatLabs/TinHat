     "opponents": 2
    },
    "expect": true,
    "why": "all-in players still see theirs"
   },
   {
    "id": "folded",
    "in": {
     "setting": true,
     "you_state": "folded",
     "street": "flop",
     "result": null,
     "face": "up",
     "opponents": 2
    },
    "expect": false,
    "why": "folded: hidden"
   },
   {
    "id": "away",
    "in": {
     "setting": true,
     "you_state": "away",
     "street": "flop",
     "result": null,
     "face": "up",
     "opponents": 2
    },
    "expect": false,
    "why": "away: hidden"
   },
   {
    "id": "showdown",
    "in": {
     "setting": true,
     "you_state": "active",
     "street": "showdown",
     "result": null,
     "face": "up",
     "opponents": 2
    },
    "expect": false,
    "why": "showdown: hidden"
   },
   {
    "id": "result",
    "in": {
     "setting": true,
     "you_state": "active",
     "street": "river",
     "result": {
      "winners": [
       1
      ]
     },
     "face": "up",
     "opponents": 2
    },
    "expect": false,
    "why": "hand done: hidden"
   },
   {
    "id": "sharing",
    "in": {
     "setting": true,
     "you_state": "active",
     "street": "flop",
     "result": null,
     "face": "down",
     "opponents": 2
    },
    "expect": false,
    "why": "cards face down (sharing): hidden"
   },
   {
    "id": "peek-not-held",
    "in": {
     "setting": true,
     "you_state": "active",
     "street": "flop",
     "result": null,
     "face": "peek",
     "opponents": 2
    },
    "expect": false,
    "why": "face down for the Pad, not peeking: hidden"
   },
   {
    "id": "peeking",
    "in": {
     "setting": true,
     "you_state": "active",
     "street": "flop",
     "result": null,
     "face": "peeking",
     "opponents": 2
    },
    "expect": true,
    "why": "while holding to peek: shown"
   },
   {
    "id": "no-opponents",
    "in": {
     "setting": true,
     "you_state": "active",
     "street": "flop",
     "result": null,
     "face": "up",
     "opponents": 0
    },
    "expect": false,
    "why": "everyone else folded: hidden"
   },
   {
    "id": "setting-off",
    "in": {
     "setting": false,
     "you_state": "active",
     "street": "flop",
     "result": null,
     "face": "up",
     "opponents": 2
    },
    "expect": false,
    "why": "Show my odds off"
   },
   {
    "id": "setting-not-bool",
    "in": {
     "setting": "true",
     "you_state": "active",
     "street": "flop",
     "result": null,
     "face": "up",
     "opponents": 2
    },
    "expect": false,
    "why": "only literal true counts"
   }
  ]
 },
