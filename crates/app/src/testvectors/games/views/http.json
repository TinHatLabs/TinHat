{
 "about": "Base: https://<server>/api/play/v1 (the room's own server, rankServerFor). Header Authorization: Play <session> on everything but POST /session. CORS *, no cookies. Errors: {code, error} with the status in errors.json. All bodies JSON.",
 "endpoints": [
  {
   "method": "POST",
   "path": "/session",
   "def_req": "sessionRequest",
   "def": "sessionAnswer",
   "status": 200,
   "req": {
    "openid": {
     "access_token": "<from POST /_matrix/client/v3/user/{me}/openid/request_token>",
     "matrix_server_name": "example.org",
     "token_type": "Bearer",
     "expires_in": 3600
    },
    "user_id": "@ana:example.org",
    "client": {
     "kind": "desktop",
     "v": "12.2.0",
     "pad": false
    }
   },
   "res": {
    "v": 1,
    "session": "Q2hpcHNBcmVQbGF5TW9uZXlPbmx5LUFfVGVzdDAxMjM",
    "user": "@ana:example.org",
    "expires": 1763628800000,
    "wallets": [
     "!hangout:example.org"
    ],
    "rig_hidden": false
   }
  },
  {
   "method": "GET",
   "path": "/rooms/{room}/space",
   "def": "spaceAnswer",
   "status": 200,
   "about": "the room's game space as THIS server decides it (game_space, server mode). Errors: 403 not-member (naming nothing: not joined to the room AND its space), 403 no-space, 403 is-space never (a space is no-space here), 403 wrong-server {space, server} (the app shows it, never follows it), 503 unavailable.",
   "req": null,
   "res": {
    "space": "!hangout:example.org",
    "server": "example.org"
   },
   "errors": [
    {
     "status": 403,
     "body": {
      "code": "wrong-server",
      "error": "this room's chips are kept by another server",
      "space": "!squad:other.example",
      "server": "other.example"
     }
    },
    {
     "status": 403,
     "body": {
      "code": "no-space",
      "error": "games live in spaces"
     }
    },
    {
     "status": 503,
     "body": {
      "code": "unavailable",
      "error": "this server can't see the room's space in full yet"
     }
    },
    {
     "status": 403,
     "body": {
      "code": "not-member",
      "error": "not a member"
     }
    }
   ]
  },
