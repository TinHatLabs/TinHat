 "game_visible": {
  "about": "Show a game only when the room's server says features.play === true. Hold'em: always then. The Rig: unless inside a phone app (phone_app = window.tinhatNative.info.platform is ios or android) where features.play_rig_phone_apps must be exactly true. Anything else: hidden.",
  "cases": [
   {
    "id": "holdem-browser",
    "game": "holdem",
    "ctx": {
     "play": true,
     "phone_app": false
    },
    "expect": true
   },
   {
    "id": "holdem-phone-app",
    "game": "holdem",
    "ctx": {
     "play": true,
     "phone_app": true,
     "rig_phone_apps": false
    },
    "expect": true
   },
   {
    "id": "rig-browser",
    "game": "rig",
    "ctx": {
     "play": true,
     "phone_app": false,
     "rig_phone_apps": false
    },
    "expect": true
   },
   {
    "id": "rig-phone-app-off",
    "game": "rig",
    "ctx": {
     "play": true,
     "phone_app": true,
     "rig_phone_apps": false
    },
    "expect": false
   },
   {
    "id": "rig-phone-app-absent",
    "game": "rig",
    "ctx": {
     "play": true,
     "phone_app": true
    },
    "expect": false
   },
   {
    "id": "rig-phone-app-truthy-string",
    "game": "rig",
    "ctx": {
     "play": true,
     "phone_app": true,
     "rig_phone_apps": "true"
    },
    "expect": false
   },
   {
    "id": "rig-phone-app-on",
    "game": "rig",
    "ctx": {
     "play": true,
     "phone_app": true,
     "rig_phone_apps": true
    },
    "expect": true
   },
   {
    "id": "no-play-flag",
    "game": "holdem",
    "ctx": {
     "phone_app": false
    },
    "expect": false
   },
   {
    "id": "play-flag-not-true",
    "game": "holdem",
    "ctx": {
     "play": 1,
     "phone_app": false
    },
    "expect": false
   },
   {
    "id": "unknown-game",
    "game": "bingo",
    "ctx": {
     "play": true,
     "phone_app": false
    },
    "expect": false
   }
  ]
 },
 "game_space": {
  "about": "Which space's chips a room uses (rev 2b; Tin Hat's own, stricter-than-Matrix policy). Input = CURRENT resolved state only: the room (its m.room.create type; its m.space.parent events: state key = space id, content) and the spaces whose current, full state the caller holds (create-event sender and type, m.space.child events; partial = state still incomplete). A room whose create type is m.space: is-space. Candidates = the room's parents whose content.via is a list of 1-20 strings of 1-255 characters; order: content.canonical exactly true first, then space id by code point. Walk the candidates in order: a space the caller doesn't hold (or holds partially) -> unavailable (NEVER skipped); a candidate whose create type isn't m.space, or that doesn't list the room back with a valid via, is skipped; the first that lists it back is the game space. None -> no-space. Owner = the server part of the space's create-event SENDER (never a via). Server mode: an owner other than this server -> wrong-server (space + owner named). No child-only fallback, no walking up to parents of spaces.",
  "cases": [
   {
    "id": "two-way-parent",
    "ctx": {
     "mode": "server",
     "decider": "example.org",
     "room": {
      "id": "!r",
      "parents": [
       {
        "space": "!S",
        "content": {
         "via": [
          "example.org"
         ],
         "canonical": true
        }
       }
      ]
     },
     "spaces": {
      "!S": {
       "create_sender": "@alice:example.org",
       "create_type": "m.space",
       "children": [
        {
         "room": "!r",
         "content": {
          "via": [
           "example.org"
          ]
         }
        }
       ]
      }
     }
    },
    "expect": {
     "space": "!S",
     "server": "example.org",
     "why": ""
    },
    "why": "the room names the space and the space lists the room: that space's chips"
   },
   {
    "id": "one-way-parent-refused",
    "ctx": {
     "mode": "server",
     "decider": "example.org",
     "room": {
      "id": "!r",
      "parents": [
       {
        "space": "!S",
        "content": {
         "via": [
          "example.org"
         ]
        }
       }
      ]
     },
     "spaces": {
      "!S": {
       "create_sender": "@alice:example.org",
       "create_type": "m.space",
       "children": []
      }
     }
    },
    "expect": {
     "space": null,
     "server": null,
     "why": "no-space"
    },
    "why": "a room admin claiming a space that doesn't list the room gets nothing"
   },
   {
    "id": "space-lists-only-other-rooms",
    "ctx": {
     "mode": "server",
     "decider": "example.org",
     "room": {
      "id": "!r",
      "parents": [
       {
        "space": "!S",
        "content": {
         "via": [
          "example.org"
         ]
        }
       }
      ]
     },
     "spaces": {
      "!S": {
       "create_sender": "@alice:example.org",
       "create_type": "m.space",
       "children": [
        {
         "room": "!other",
         "content": {
          "via": [
           "example.org"
          ]
         }
        },
        {
         "room": "!another",
         "content": {
          "via": [
           "example.org"
          ]
         }
        }
       ]
      }
     }
    },
    "expect": {
     "space": null,
     "server": null,
     "why": "no-space"
    },
    "why": "the space has child links, but none for THIS room: a reader where any child link counts would pick !S (games-token, 11-19)"
   },
   {
    "id": "child-only-refused",
    "ctx": {
     "mode": "server",
     "decider": "example.org",
     "room": {
      "id": "!r",
      "parents": []
