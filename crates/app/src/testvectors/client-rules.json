 "prestige_tier": {
  "about": "rank -> the token's look. Only a JSON integer >= 1 draws a token (2.5, \"3\", true, null, negatives: none). Tiers: 1 outline/muted; 2 filled/text; 3-4 filled/accent; 5-7 + ring; 8-12 + star; 13+ + a one-time shine.",
  "cases": [
   {
    "rank": 0,
    "expect": {
     "tier": 0,
     "glyph": "none",
     "colour": "none",
     "ring": false,
     "star": false,
     "shine": false
    }
   },
   {
    "rank": 1,
    "expect": {
     "tier": 1,
     "glyph": "outline",
     "colour": "muted",
     "ring": false,
     "star": false,
     "shine": false
    }
   },
   {
    "rank": 2,
    "expect": {
     "tier": 2,
     "glyph": "filled",
     "colour": "text",
     "ring": false,
     "star": false,
     "shine": false
    }
   },
   {
    "rank": 3,
    "expect": {
