 },
 "whisper_alone": {
  "about": "The Rig: before a Whisper is sent, warn when the whisperer is the only CONNECTED House member (House = mechanic, sharp, railbird; not the Spinner; a member who left the round doesn't count; connected must be exactly true), because the Spinner would know who wrote it. The warning (both apps, word for word): \"You're the only House member here, so the Spinner will know this is from you.\" Never promise anonymity when it isn't true (launch-gate 11-19).",
  "cases": [
   {
    "id": "others-connected",
    "roster": [
     {
      "u": "@s:x",
      "role": "spinner",
      "connected": true
     },
     {
      "u": "@a:x",
      "role": "mechanic",
      "connected": true
     },
     {
      "u": "@b:x",
      "role": "mechanic",
      "connected": true
     },
     {
      "u": "@c:x",
      "role": "sharp",
      "connected": true
     }
    ],
    "whisperer": "@a:x",
    "expect": {
     "warn": false
    },
    "why": "two other House members are connected: the Spinner can't tell who"
   },
   {
    "id": "only-one-connected",
    "roster": [
     {
      "u": "@s:x",
      "role": "spinner",
      "connected": true
     },
     {
      "u": "@a:x",
      "role": "mechanic",
      "connected": true
     },
     {
      "u": "@b:x",
      "role": "mechanic",
      "connected": false
     },
     {
      "u": "@c:x",
      "role": "sharp",
      "connected": false
     }
    ],
    "whisperer": "@a:x",
    "expect": {
     "warn": true
    },
    "why": "everyone else in the House is disconnected: warn first"
   },
   {
    "id": "one-other-connected",
    "roster": [
     {
      "u": "@s:x",
      "role": "spinner",
      "connected": true
     },
     {
      "u": "@a:x",
      "role": "sharp",
      "connected": true
     },
     {
      "u": "@b:x",
      "role": "mechanic",
      "connected": true
     },
     {
      "u": "@c:x",
      "role": "sharp",
      "connected": false
     }
    ],
    "whisperer": "@a:x",
    "expect": {
     "warn": false
    },
    "why": "one other connected House member is enough to hide among"
   },
   {
    "id": "spinner-is-not-house",
    "roster": [
     {
      "u": "@s:x",
      "role": "spinner",
      "connected": true
     },
     {
      "u": "@a:x",
      "role": "mechanic",
      "connected": true
     },
     {
      "u": "@b:x",
      "role": "mechanic",
      "connected": false
     }
    ],
    "whisperer": "@a:x",
    "expect": {
     "warn": true
    },
    "why": "the connected Spinner is not House: still alone"
   },
   {
    "id": "left-member-not-counted",
    "roster": [
     {
      "u": "@s:x",
      "role": "spinner",
      "connected": true
     },
     {
      "u": "@a:x",
      "role": "mechanic",
      "connected": true
     },
     {
      "u": "@b:x",
      "role": "sharp",
      "connected": true,
      "left": true
     }
    ],
    "whisperer": "@a:x",
    "expect": {
     "warn": true
    },
    "why": "a House member who left the round doesn't count, even if still connected"
   },
   {
    "id": "railbird-counts",
    "roster": [
     {
      "u": "@s:x",
      "role": "spinner",
      "connected": true
     },
     {
      "u": "@a:x",
      "role": "sharp",
      "connected": true
     },
     {
      "u": "@r:x",
      "role": "railbird",
      "connected": true
