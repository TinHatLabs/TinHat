    "whisperer": "@a:x",
    "expect": {
     "warn": false
    },
    "why": "a Railbird is a House member (they can Whisper too)"
   },
   {
    "id": "connected-must-be-true",
    "roster": [
     {
      "u": "@s:x",
      "role": "spinner",
      "connected": true
     },
     {
      "u": "@a:x",
      "role": "mechanic",
      "connected": true
     },
     {
      "u": "@b:x",
      "role": "sharp",
      "connected": "true"
