 "report_plan": [
  {
   "name": "message with the inbox",
   "tinhat": true,
   "target": {
    "user": "@bad:x",
    "room": "!r:x",
    "event": "$e/1"
   },
   "category": "spam",
   "details": "",
   "expect": [
    {
     "via": "tinhat",
     "method": "POST",
     "path": "/reports",
     "body": {
      "$report": true
     }
    },
    {
     "via": "matrix",
     "method": "POST",
     "path": "/rooms/!r%3Ax/report/%24e%2F1",
     "body": {
      "reason": "Spam or a scam"
     }
    }
   ]
  },
  {
   "name": "person in a room, no inbox",
   "tinhat": false,
   "target": {
    "user": "@bad:x",
    "room": "!r:x",
    "event": ""
   },
   "category": "sexual",
   "details": "pics",
   "expect": [
    {
     "via": "matrix",
     "method": "POST",
     "path": "/users/%40bad%3Ax/report",
     "body": {
      "reason": "Sexual content: pics"
     }
    },
    {
     "via": "matrix",
     "method": "POST",
     "path": "/rooms/!r%3Ax/report",
     "body": {
      "reason": "Sexual content: pics (reported: @bad:x)"
     }
    }
   ]
  },
  {
   "name": "person, nowhere",
   "tinhat": true,
   "target": {
    "user": "@b'(*)~:x",
    "room": "",
    "event": ""
   },
   "category": "other",
   "details": "x",
   "expect": [
    {
     "via": "tinhat",
     "method": "POST",
     "path": "/reports",
     "body": {
      "$report": true
     }
    },
    {
     "via": "matrix",
     "method": "POST",
     "path": "/users/%40b'(*)~%3Ax/report",
     "body": {
      "reason": "Something else: x"
     }
    }
   ]
  }
 ],
