{
 "about": "Account safety shared vectors (web src/core/safety.ts, desktop crates/app/src/safety.rs). docs/ACCOUNT-SAFETY.md.",
 "ignored_users": [
  {
   "name": "no content",
   "content": null,
   "expect": []
  },
  {
   "name": "not an object",
   "content": [
    1
   ],
   "expect": []
  },
  {
   "name": "no map",
   "content": {
    "other": 1
   },
   "expect": []
  },
  {
   "name": "sorted, invalid dropped",
   "content": {
    "ignored_users": {
     "@b:x": {},
     "@a:x": {
      "why": 1
     },
     "nope": {},
     "@ bad:x": {}
    }
   },
   "expect": [
    "@a:x",
    "@b:x"
   ]
  }
 ],
 "with_ignored": [
  {
   "name": "add to nothing",
   "content": null,
   "mxid": "@a:x",
   "ignore": true,
   "expect": {
    "ignored_users": {
     "@a:x": {}
    }
   }
  },
  {
   "name": "add keeps others and extra keys",
   "content": {
    "ignored_users": {
     "@b:x": {
      "k": 1
     }
    },
    "extra": true
   },
   "mxid": "@a:x",
   "ignore": true,
   "expect": {
    "ignored_users": {
     "@b:x": {
      "k": 1
     },
     "@a:x": {}
    },
    "extra": true
   }
  },
  {
   "name": "add twice keeps the entry",
   "content": {
    "ignored_users": {
     "@a:x": {
      "k": 2
     }
    }
   },
   "mxid": "@a:x",
   "ignore": true,
   "expect": {
    "ignored_users": {
     "@a:x": {
      "k": 2
     }
    }
   }
  },
  {
   "name": "add over a non-object entry",
   "content": {
    "ignored_users": {
     "@a:x": 5
    }
   },
   "mxid": "@a:x",
   "ignore": true,
   "expect": {
    "ignored_users": {
     "@a:x": {}
    }
   }
  },
  {
   "name": "remove",
   "content": {
    "ignored_users": {
     "@a:x": {},
     "@b:x": {}
    }
   },
   "mxid": "@a:x",
   "ignore": false,
   "expect": {
    "ignored_users": {
     "@b:x": {}
    }
   }
  },
  {
   "name": "remove absent",
   "content": {
    "ignored_users": {}
   },
   "mxid": "@a:x",
   "ignore": false,
   "expect": {
    "ignored_users": {}
   }
  },
  {
   "name": "map not an object",
   "content": {
    "ignored_users": []
   },
   "mxid": "@a:x",
   "ignore": true,
   "expect": {
    "ignored_users": {
     "@a:x": {}
    }
   }
  }
 ],
