 "deactivate_body": [
  {
   "auth": null,
   "expect": {
    "erase": true
   }
  },
  {
   "auth": {
    "user": "@me:x",
    "password": "pw"
   },
   "expect": {
    "erase": true,
    "auth": {
     "type": "m.login.password",
     "identifier": {
      "type": "m.id.user",
      "user": "@me:x"
     },
     "password": "pw"
    }
   }
  },
  {
   "auth": {
    "user": "@me:x",
    "password": "pw",
    "session": "S"
   },
   "expect": {
    "erase": true,
    "auth": {
     "type": "m.login.password",
     "identifier": {
      "type": "m.id.user",
      "user": "@me:x"
     },
     "password": "pw",
     "session": "S"
    }
   }
  }
 ],
 "delete_first": [
  {
   "status": 200,
   "body": "{}",
   "expect": {
    "step": "done"
   }
  },
  {
   "status": 401,
   "body": "{\"flows\":[{\"stages\":[\"m.login.password\"]}],\"session\":\"S\"}",
   "expect": {
    "step": "password",
    "session": "S"
   }
  },
  {
   "status": 401,
   "body": "{\"flows\":[{\"stages\":[\"m.login.password\"]}]}",
   "expect": {
    "step": "password"
   }
  },
  {
   "status": 401,
   "body": "{\"flows\":[{\"stages\":[\"m.login.sso\"]},{\"stages\":[\"m.login.password\",\"m.login.email.identity\"]}],\"session\":\"S\"}",
   "expect": {
    "step": "failed",
    "text": "This server wants another way to confirm it's you: delete your account where you signed up."
   }
  },
  {
   "status": 401,
   "body": "{\"errcode\":\"M_UNKNOWN_TOKEN\",\"error\":\"Invalid access token\"}",
   "expect": {
    "step": "failed",
    "text": "Invalid access token"
   }
  },
  {
   "status": 403,
   "body": "not json",
   "expect": {
    "step": "failed",
    "text": "The server didn't delete the account (HTTP 403)."
   }
  }
 ],
 "delete_second": [
  {
   "status": 200,
   "body": "{\"id_server_unbind_result\":\"no-support\"}",
   "expect": {
    "kind": "deleted"
   }
  },
  {
   "status": 401,
   "body": "{\"errcode\":\"M_FORBIDDEN\",\"error\":\"Invalid username or password\",\"flows\":[]}",
   "expect": {
    "kind": "wrong",
    "text": "That isn't your password."
   }
  },
  {
   "status": 403,
   "body": "{\"errcode\":\"M_FORBIDDEN\",\"error\":\"Deactivation is disabled\"}",
   "expect": {
    "kind": "failed",
    "text": "Deactivation is disabled"
   }
  },
  {
   "status": 500,
   "body": "{\"error\":\"  \"}",
   "expect": {
    "kind": "failed",
    "text": "The server didn't delete the account (HTTP 500)."
   }
  }
 ],
