{
  "format": "tinhat-widgets",
  "v": 1,
  "defaults": ["upNext", "callStats", "whosAround"],
  "widgets": [
    {
      "id": "upNext",
      "title": "Up next",
      "icon": "view-calendar-symbolic",
      "description": "Your next events from every space's calendar: RSVP, the game and a countdown.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [
        {"id": "days", "type": "int", "label": "Look ahead", "unit": "days", "min": 1, "max": 14, "default": 7}
      ],
      "data": ["calendar", "calls"],
      "refresh": {"focused": "event", "unfocused": "60s"},
      "motions": ["ringStep", "rowSlide", "avatarSlide", "coverFade", "soonEdge"],
      "phone": true
    },
    {
      "id": "callStats",
      "title": "Call stats",
      "icon": "view-statistics-symbolic",
      "description": "In a call: what you get from each person and how they get you. Otherwise: your last call and this week.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["call", "rxq", "callHistory"],
      "refresh": {"focused": "1s", "unfocused": "5s"},
      "motions": ["laneEase", "sparkStep", "lossFlash"],
      "phone": true
    },
    {
      "id": "whosAround",
      "title": "Who's around",
      "icon": "system-users-symbolic",
      "description": "Friends who share their status: in a call, playing, online, away.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [
        {"id": "away", "type": "bool", "label": "Show people who are away", "default": true}
      ],
      "data": ["presence", "calls", "activity"],
      "refresh": {"focused": "event", "unfocused": "event"},
      "motions": ["personSlide", "coverFade", "countRoll"],
      "phone": true
    },
    {
      "id": "pinned",
      "title": "Pinned",
      "icon": "window-pin-symbolic",
      "description": "The open room's pinned messages, newest first. Click one to jump to it.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["room", "pins"],
      "refresh": {"focused": "event", "unfocused": "event"},
      "motions": ["rowSlide"],
      "phone": true
    },
    {
      "id": "gameServers",
      "title": "Game servers",
      "icon": "network-server-symbolic",
      "description": "Your server's game servers: what runs, who's on, the join address and password. The people with that role start, stop and restart them.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["gameservers", "calendar"],
      "refresh": {"focused": "15s", "unfocused": "60s"},
      "motions": ["stateFade", "barEase", "rowSlide"],
      "phone": true
    },
    {
      "id": "mentions",
      "title": "Mentions",
      "icon": "mail-reply-sender-symbolic",
      "description": "Your recent mentions and replies across rooms, kept on this device. Click one to jump to it.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 240, "L": 420},
      "settings": [],
      "data": ["highlights", "rooms"],
      "refresh": {"focused": "event", "unfocused": "event"},
      "motions": ["rowSlide"],
      "phone": true
    },
    {
      "id": "note",
      "title": "Sticky note",
      "icon": "document-edit-symbolic",
      "description": "One shared note for the space you are in: tonight's plan, who brings what.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["space", "note", "roles"],
      "refresh": {"focused": "event", "unfocused": "event"},
      "motions": ["noteFade"],
      "phone": true
    },
    {
      "id": "clocks",
      "title": "Friends' clocks",
      "icon": "globe-symbolic",
      "description": "Your friends' local time, west to east, with day and night: handy before you ping someone.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["presence", "timezones"],
      "refresh": {"focused": "60s", "unfocused": "60s"},
      "motions": ["rowSlide"],
      "phone": true
    },
    {
      "id": "dice",
      "title": "Dice",
      "icon": "applications-games-symbolic",
      "description": "Roll for the room or just for you: d4 to d100, 2d6+3, keep highest, advantage. Your table's recent rolls stay in the history.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 270, "L": 480},
      "settings": [
        {"id": "private", "type": "bool", "label": "Roll privately (only you see the result)", "default": false}
      ],
      "data": ["room", "timeline", "privateRolls"],
      "refresh": {"focused": "event", "unfocused": "event"},
      "motions": ["diceTumble", "rowSlide"],
      "phone": true
    },
    {
      "id": "justMe",
      "title": "Is it just me?",
      "icon": "network-connect",
      "description": "Is the server down, or is it your connection? Chat, calls, media and the extras measured from this device, plus your ping.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["probes", "sync"],
      "refresh": {"focused": "60s", "unfocused": "300s"},
      "motions": ["stateFade"],
      "phone": true
    },
    {
      "id": "memories",
      "title": "Memories",
      "icon": "camera-video-symbolic",
      "description": "Your latest recordings from the Memories DVR, newest first. Click one to relive it.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["vods", "rooms"],
      "refresh": {"focused": "300s", "unfocused": "900s"},
      "motions": ["rowSlide"],
      "phone": true
    },
    {
      "id": "soundPad",
      "title": "Soundboard pad",
      "icon": "audio-speakers-symbolic",
      "description": "Your favourite sounds as big buttons: into the call when you're in one, a quiet preview otherwise.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["soundboard", "call"],
      "refresh": {"focused": "event", "unfocused": "event"},
      "motions": ["pressRipple"],
      "phone": true
    },
    {
      "id": "polls",
      "title": "Polls",
      "icon": "view-statistics-symbolic",
      "description": "The open polls in this room: see where each stands and jump in to vote. Start a new one in a click; Element users can vote too.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["room", "timeline"],
      "refresh": {"focused": "event", "unfocused": "event"},
      "motions": ["rowSlide"],
      "phone": true
    },
    {
      "id": "gameNight",
      "title": "Game night",
      "icon": "applications-games-symbolic",
      "description": "The next game night: its game from the Reel (or Pick / Spin), a countdown, who's going, your RSVP and credit, the game's server.",
      "sizes": ["S", "M", "L"],
      "default": "M",
      "maxH": {"M": 220, "L": 420},
      "settings": [],
      "data": ["calendar", "games", "gameservers"],
      "refresh": {"focused": "event", "unfocused": "60s"},
      "motions": ["avatarSlide", "coverFade", "rowSlide"],
      "phone": true
    }
  ]
}
