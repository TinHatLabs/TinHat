     "do": "take",
     "kind": "meter",
     "owner": null,
     "as": "m",
     "ok": true
    },
    {
     "do": "begin_start",
     "lease": "m",
     "ok": true
    },
    {
     "do": "end_start",
     "lease": "m",
     "ok": true
    },
    {
     "do": "hold",
     "lease": "m",
     "res": "t",
     "ok": true
    },
    {
     "do": "revoke",
     "why": "watch",
     "n": 1,
     "stopped": [
      "t"
     ]
    }
   ]
  },
  {
   "name": "L17 round 6: a starting lease is pending until its operation ends",
   "steps": [
